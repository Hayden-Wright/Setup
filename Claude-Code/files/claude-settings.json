{
  "theme": "dark",
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "mcp__deploychan__list_recommended",
      "mcp__deploychan__list_skills",
      "mcp__deploychan__search_knowledge",
      "mcp__deploychan__get_item",
      "mcp__deploychan__get_skill",
      "mcp__deploychan__onboard",
      "mcp__deploychan__next_step",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(which:*)",
      "Bash(command -v:*)",
      "Bash(curl:*)",
      "Bash(dig:*)",
      "Bash(getent:*)",
      "Bash(ping:*)",
      "Bash(echo:*)",
      "Bash(whoami)",
      "Bash(hostname)",
      "Bash(pwd)",
      "Bash(uname:*)",
      "Read(//home/**)",
      "Read",
      "Glob",
      "Grep",
      "Bash",
      "Write",
      "Edit",
      "NotebookEdit",
      "TodoWrite",
      "Task"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/zim-memory/hook-session-start.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py",
    "padding": 0,
    "refreshInterval": 5
  }
}
