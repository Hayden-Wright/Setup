                 # Quote keys that contain dots (e.g. "auth.signup_enabled")
                 key_str = f'"{k}"' if "." in k else k
                 if isinstance(v, str):
-                    # Escape backslashes and quotes in string values
-                    escaped = v.replace("\\", "\\\\").replace('"', '\\"')
+                    # Escape backslashes, quotes and control characters.
+                    # Newlines MUST be escaped: a raw newline inside a basic
+                    # TOML string makes the whole file unparseable, load_config()
+                    # then returns {}, and _get_jwt_secret() silently mints a new
+                    # secret — logging every existing session out.
+                    escaped = (
+                        v.replace("\\", "\\\\")
+                        .replace('"', '\\"')
+                        .replace("\n", "\\n")
+                        .replace("\r", "\\r")
+                        .replace("\t", "\\t")
+                    )
                     lines.append(f'{key_str} = "{escaped}"')
                 elif isinstance(v, bool):
                     lines.append(f"{key_str} = {'true' if v else 'false'}")
