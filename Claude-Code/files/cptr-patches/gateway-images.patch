+# ── Incoming image attachments ───────────────────────────────
+
+_DATA_URI_RE = re.compile(r"^data:(?P<mime>[^;,]+)?(?P<params>(?:;[^;,]+)*),(?P<payload>.*)$", re.S)
+_IMAGE_MIME_BY_EXT = {
+    ".png": "image/png",
+    ".jpg": "image/jpeg",
+    ".jpeg": "image/jpeg",
+    ".gif": "image/gif",
+    ".webp": "image/webp",
+    ".bmp": "image/bmp",
+    ".tif": "image/tiff",
+    ".tiff": "image/tiff",
+    ".heic": "image/heic",
+    ".avif": "image/avif",
+}
+_MAX_IMAGE_BYTES = 20 * 1024 * 1024
+_IMAGE_FETCH_TIMEOUT_S = 30
+
+
+def _extract_image_blocks(message: dict | None) -> list[dict]:
+    """Collect OpenAI-style image_url blocks from a chat message.
+
+    Handles the two shapes OWUI sends: a ``content`` list of blocks, and the
+    legacy single ``{"type": "image_url"}`` block.
+    """
+    if not isinstance(message, dict):
+        return []
+    content = message.get("content")
+    if not isinstance(content, list):
+        return []
+    blocks = []
+    for block in content:
+        if not isinstance(block, dict) or block.get("type") != "image_url":
+            continue
+        image_url = block.get("image_url")
+        if isinstance(image_url, dict):
+            url = image_url.get("url")
+        else:
+            url = image_url
+        if isinstance(url, str) and url.strip():
+            blocks.append({"url": url.strip()})
+    return blocks
+
+
+async def _decode_image_url(url: str) -> tuple[bytes, str] | None:
+    """Turn an image_url value into (bytes, content_type).
+
+    Supports inline ``data:image/...;base64,...`` URIs and plain http(s) URLs
+    (downloaded here, since the agent backend has no way to fetch them).
+    Returns None when the value cannot be turned into bytes.
+    """
+    match = _DATA_URI_RE.match(url)
+    if match:
+        mime = (match.group("mime") or "image/png").strip().lower()
+        params = (match.group("params") or "").lower()
+        payload = match.group("payload").strip()
+        try:
+            if "base64" in params:
+                data = base64.b64decode(payload, validate=False)
+            else:
+                from urllib.parse import unquote_to_bytes
+
+                data = unquote_to_bytes(payload)
+        except (binascii.Error, ValueError) as exc:
+            logger.warning("[attachments] Could not decode inline image data URI: %s", exc)
+            return None
+        if not data:
+            logger.warning("[attachments] Inline image data URI decoded to 0 bytes")
+            return None
+        if len(data) > _MAX_IMAGE_BYTES:
+            logger.warning("[attachments] Inline image too large (%d bytes), skipping", len(data))
+            return None
+        if not mime.startswith("image/"):
+            mime = "image/png"
+        return data, mime
+
+    parsed = urlparse(url)
+    if parsed.scheme not in ("http", "https"):
+        logger.warning("[attachments] Unsupported image_url scheme: %r", url[:80])
+        return None
+    try:
+        import httpx
+
+        async with httpx.AsyncClient(
+            timeout=_IMAGE_FETCH_TIMEOUT_S, follow_redirects=True
+        ) as client:
+            response = await client.get(url)
+            response.raise_for_status()
+            data = response.content
+            header_type = response.headers.get("content-type") or ""
+    except Exception as exc:
+        logger.warning("[attachments] Could not download image_url %s: %s", url[:120], exc)
+        return None
+    if not data:
+        logger.warning("[attachments] Downloaded image is empty: %s", url[:120])
+        return None
+    if len(data) > _MAX_IMAGE_BYTES:
+        logger.warning("[attachments] Downloaded image too large (%d bytes), skipping", len(data))
+        return None
+    content_type = header_type.split(";")[0].strip().lower()
+    if not content_type.startswith("image/"):
+        ext = Path(parsed.path).suffix.lower()
+        content_type = _IMAGE_MIME_BY_EXT.get(ext, "image/png")
+    return data, content_type
+
+
+def _guess_image_name(url: str, content_type: str, index: int) -> str:
+    """Best-effort filename for a stored image."""
+    parsed = urlparse(url)
+    # A data: URI has no filename to borrow, so fall back to a generic one.
+    path = parsed.path if parsed.scheme in ("http", "https") else ""
+    name = Path(path).name if path else ""
+    if not name or "." not in name:
+        ext = next((e for e, m in _IMAGE_MIME_BY_EXT.items() if m == content_type), ".png")
+        name = f"image-{index + 1}{ext}"
+    return name
+
+
+async def _stage_incoming_images(blocks: list[dict]) -> list[dict]:
+    """Persist incoming image blocks to storage and return ChatMessage meta files.
+
+    The downstream pipeline (prepare_agent_attachments → storage.get) needs the
+    bytes to live under the storage key, so each image is written before the
+    message row references it. A broken image is logged and skipped — the text
+    of the message must survive.
+    """
+    files: list[dict] = []
+    storage = get_storage()
+    for index, block in enumerate(blocks):
+        url = block["url"]
+        decoded = await _decode_image_url(url)
+        if decoded is None:
+            continue
+        data, content_type = decoded
+        name = _guess_image_name(url, content_type, index)
+        file_id = str(uuid.uuid4())
+        try:
+            await storage.put(file_id, data)
+        except Exception as exc:
+            logger.warning("[attachments] Could not store image %s: %s", name, exc)
+            continue
+        files.append(
+            {
+                "id": file_id,
+                "name": name,
+                "type": "image",
+                "content_type": content_type,
+                "size": len(data),
+            }
+        )
+    if files:
+        logger.info(
+            "[attachments] Staged %d incoming image(s) for the agent: %s",
+            len(files),
+            ", ".join(f["name"] for f in files),
+        )
+    return files
+
+
+def _normalize_owui_files(raw: object) -> list[dict]:
+    """Accept the file entries OWUI puts on body.user_message, when present."""
+    if not isinstance(raw, list):
+        return []
+    files = []
+    for item in raw:
+        if not isinstance(item, dict):
+            continue
+        file_id = item.get("id") or item.get("file_id")
+        if not isinstance(file_id, str) or not file_id:
+            continue
+        entry = {
+            "id": file_id,
+            "name": str(item.get("name") or item.get("filename") or file_id),
+            "type": str(item.get("type") or ""),
+        }
+        content_type = item.get("content_type") or item.get("mime_type")
+        if content_type:
+            entry["content_type"] = str(content_type)
+        if isinstance(item.get("size"), int):
+            entry["size"] = item["size"]
+        files.append(entry)
+    return files
+
+
