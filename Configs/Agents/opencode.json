{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "mcp": {
    "deploychan": {
      "type": "remote",
      "url": "https://mcp.deploychan.webcam/mcp",
      "oauth": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },
  "provider": {
    "logfare": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Logfare",
      "options": {
        "baseURL": "https://logfare.ai/v1",
        "apiKey": "{env:LOGFARE_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash-1017": {
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        }
      }
    },
    "tokenjuice": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Token Juice",
      "options": {
        "baseURL": "https://api.tokenjuice.ai/v1",
        "apiKey": "{env:TOKENJUICE_API_KEY}"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4.1-Flash-1017": {
          "limit": {
            "context": 262144,
            "output": 8192
          }
        }
      }
    }
  }
}
